


import os #library working with files
import urllib.request # library working with downloading files from internet

if not os.path.exists("the-verdict.txt"):

    url = "https://raw.githubusercontent.com/rasbt/LLMs-from-scratch/refs/heads/main/ch02/01_main-chapter-code/the-verdict.txt"

    file_path = "the-verdict.txt"

    urllib.request.urlretrieve(url, file_path)

    print("File downloaded successfully!")
else:
    print("File already exists!")


with open("the-verdict.txt","r",encoding="utf-8") as f:
    raw_text = f.read()


len(raw_text)








import re                 #py regular expression library
text = "Hello World. This, is a test."
res = re.split(r'(\s)',text)          # regular expression that splits on white spaces
print(res)


res = re.split(r'([,.]|\s)',text)          # regular expression that splits on white spaces and panchuation 


print(res)


res = [i for i in res if i.strip()]       #removes white paces
print(res)


txt = "Hello World. Is this-- a test?" 
res = re.split(r'([,.:;?_!"()\')]|--|\s)',txt)  # 
res = [i.strip() for i in res if i.strip()]
print(res)





res = re.split(r'([,.:;?_!"()\')]|--|\s)',raw_text)
res = [i.strip() for i in res if i.strip()]
preProcessed = res  #preprocessed contains all the tokenized text form raw_text


len(preProcessed)



